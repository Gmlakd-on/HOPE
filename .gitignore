**/.turbo/

*.tsbuildinfo

# =========================================================
# Supabase CLI local state
# Keep migrations, rollbacks, seed.sql, config.toml, and tests tracked.
# =========================================================
supabase/.temp/
supabase/.branches/
supabase/.supabase/

# =========================================================
# Tests, coverage, and performance reports
# =========================================================
**/coverage/
**/.nyc_output/
**/.vitest/
**/playwright-report/
**/test-results/
**/blob-report/
**/.lighthouseci/

# =========================================================
