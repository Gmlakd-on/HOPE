# =========================================================
.DS_Store
._*
.Spotlight-V100
.Trashes

Thumbs.db
Desktop.ini

# =========================================================
# Temporary files and accidental source archives
# =========================================================
**/tmp/
**/temp/

*.tmp
*.temp

*.zip
*.7z
*.rar
*.tar
*.tgz

