# =========================================================
**/logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================
# Local databases, dumps, and backups
# =========================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

*.dump
*.backup
*.bak
*.sql.gz

# =========================================================
# Terraform local state and sensitive variables
# Keep .terraform.lock.hcl tracked.
# =========================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

!*.tfvars.example
!*.tfvars.json.example

crash.log
crash.*.log

# =========================================================
