# =========================================================
# Dependencies and package-manager state
# =========================================================
node_modules/
.pnpm-store/
.npm/
.yarn/
.pnp.*

# =========================================================
# Environment variables and local runtime configuration
# =========================================================
.env
.env.*
!**/.env.example
!**/.env.*.example

.envrc
.envrc.*
!**/.envrc.example
!**/.envrc.*.example

.dev.vars
.dev.vars.*
!**/.dev.vars.example
!**/.dev.vars.*.example

.direnv/

# =========================================================
# Private keys, certificates, and credentials
# =========================================================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

credentials.json
credentials.*.json
service-account.json
service-account.*.json
*-service-account.json

