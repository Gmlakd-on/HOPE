# Local development environment
APP_ENV=development

# Public browser-visible configuration
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_INSTAGRAM_URL=https://instagram.com/YOUR_ACCOUNT
PUBLIC_CONTACT_EMAIL=YOUR_EMAIL@example.com
PUBLIC_PROJECT_001_URL=https://www.hiddenpage.co.kr
PUBLIC_COMPANY_FOUNDED_DATE=2026-07-14

# Server-only Supabase credentials
# Never add the PUBLIC_ prefix to these values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only HMAC secret for anonymized requester identifiers.
# Generate a unique random value containing at least 32 characters.
WISH_HASH_SECRET=

# Cloudflare Turnstile
# PUBLIC_TURNSTILE_SITE_KEY is intentionally browser-visible.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Local development/test escape hatch only.
# Never configure this as true in Vercel Preview or Production.
ALLOW_INSECURE_TURNSTILE=true

# Optional administrator authentication
# ADMIN_PASSWORD must contain at least 12 characters.
# ADMIN_SESSION_SECRET must contain at least 32 random characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional PostgreSQL integration-test database
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
