# Production deployment environment
APP_ENV=production

# Public browser-visible configuration
PUBLIC_SITE_URL=https://hope.ai.kr
PUBLIC_INSTAGRAM_URL=https://instagram.com/YOUR_ACCOUNT
PUBLIC_CONTACT_EMAIL=YOUR_EMAIL@example.com
PUBLIC_PROJECT_001_URL=https://www.hiddenpage.co.kr
PUBLIC_COMPANY_FOUNDED_DATE=2026-07-14

# Server-only Supabase credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=
WISH_HASH_SECRET=

# Cloudflare Turnstile: required in production
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=hope.ai.kr,www.hope.ai.kr

# Administrator authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Do not set ALLOW_INSECURE_TURNSTILE in production.
